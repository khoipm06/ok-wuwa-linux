#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source shared helpers (from this checkout, or the installed share dir)
if [ -f "${SCRIPT_DIR}/common.sh" ]; then
    source "${SCRIPT_DIR}/common.sh"
elif [ -f "${HOME}/.local/share/ok-wuwa/common.sh" ]; then
    source "${HOME}/.local/share/ok-wuwa/common.sh"
else
    echo "Error: common.sh not found. Run setup.sh first." >&2
    exit 1
fi

okww_find_resource_dir "${SCRIPT_DIR}"

# 1. Discover Steam libraries and locate the Wuthering Waves prefix
steam_discover_libs
if ! steam_find_prefix; then
    echo "Error: Prefix for App ID ${APP_ID} not found. Launch Wuthering Waves once in Steam first." >&2
    exit 1
fi

# 2. Locate Steam Linux Runtime container entry point and Proton runner
steam_find_entry_point || true
if ! steam_find_proton; then
    echo "Error: No usable Proton executable found." >&2
    exit 1
fi

# 3. Flatpak detection
steam_check_flatpak

# 4. Resolve OK-WW targets; re-apply compat patches if the app is installed
okww_find_app_dir
okww_apply_patches

DIRECT_FLAG=""
if [ "$1" = "--direct" ] || [ "$1" = "--python" ]; then
    DIRECT_FLAG="$1"
    shift
fi
okww_resolve_targets "${DIRECT_FLAG}"

# 5. Detect WebView2 Runtime; the launcher needs the render-fix sidecar or
#    Chromium never presents its first frame (blank white window).
okww_detect_wv2 || true
okww_get_render_fix_win
okww_wv2_flags
if [ -z "${RENDER_FIX_WIN}" ] && [ "${TARGET_EXE}" = "${LAUNCHER_WIN}" ]; then
    echo "Warning: WebView2 render-fix helper not installed; run setup.sh." >&2
fi

export OKWW_PROTON="${PROTON_BIN}"
export OKWW_TARGET="${TARGET_EXE}"
export OKWW_PYTHON="${PYTHON_WIN}"
export OKWW_FIX="${RENDER_FIX_WIN}"
export OKWW_ARGS="${TARGET_ARG:+${TARGET_ARG} }$*"
INNER="$(okww_build_inner_cmd)"

# 6. Host-side cursor watcher: KWin renders no cursor over cursor-less
#    XWayland windows, so define the theme cursor on the ok-ww window.
okww_start_cursor_fix

# 7. Execute OK-WuWa inside the Steam Linux Runtime container.
okww_launch_app
