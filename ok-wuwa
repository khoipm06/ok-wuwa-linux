#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ID="3513350"
APP_NAME="OK-WuWa"

# 1. Discover Steam library paths from libraryfolders.vdf
VDF_CANDIDATES=(
    "${HOME}/.steam/steam/steamapps/libraryfolders.vdf"
    "${HOME}/.steam/root/steamapps/libraryfolders.vdf"
    "${HOME}/.local/share/Steam/steamapps/libraryfolders.vdf"
    "${HOME}/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/libraryfolders.vdf"
    "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/libraryfolders.vdf"
)

STEAM_LIBS=()
for vdf in "${VDF_CANDIDATES[@]}"; do
    if [ -f "$vdf" ]; then
        while IFS= read -r line; do
            if [[ "$line" =~ \"path\"[[:space:]]+\"([^\"]+)\" ]]; then
                lib_path="${BASH_REMATCH[1]}"
                [ -d "$lib_path" ] && STEAM_LIBS+=("$lib_path")
            fi
        done < "$vdf"
    fi
done

if [ ${#STEAM_LIBS[@]} -gt 0 ]; then
    readarray -t STEAM_LIBS < <(printf '%s\n' "${STEAM_LIBS[@]}" | sort -u)
fi

# 2. Locate Prefix for Wuthering Waves (3513350)
PFX_PATH=""
for lib in "${STEAM_LIBS[@]}"; do
    cand="${lib}/steamapps/compatdata/${APP_ID}/pfx"
    [ -d "$cand" ] && { PFX_PATH="$cand"; break; }
done

if [ -z "$PFX_PATH" ]; then
    SEARCH_ROOTS=()
    for root in "/var/mnt" "/mnt" "/media" "/run/media/${USER}" "${HOME}"; do
        [ -d "$root" ] && SEARCH_ROOTS+=("$root")
    done
    if [ ${#SEARCH_ROOTS[@]} -gt 0 ]; then
        PFX_PATH=$(find "${SEARCH_ROOTS[@]}" -maxdepth 5 -path "*/steamapps/compatdata/${APP_ID}/pfx" -type d 2>/dev/null | head -n 1 || true)
    fi
fi

if [ -z "$PFX_PATH" ] || [ ! -d "$PFX_PATH" ]; then
    echo "Error: Prefix for App ID ${APP_ID} not found. Launch Wuthering Waves once in Steam first." >&2
    exit 1
fi

COMPAT_DATA_PATH="$(dirname "${PFX_PATH}")"

# 3. Locate Steam Linux Runtime container entry point
ENTRY_POINT=""
for lib in "${STEAM_LIBS[@]}"; do
    cand=$(find "${lib}/steamapps/common" -maxdepth 3 -name "_v2-entry-point" -type f -perm -111 2>/dev/null | sort -V | tail -n 1 || true)
    [ -n "$cand" ] && { ENTRY_POINT="$cand"; break; }
done

# 4. Locate Proton runner
PROTON_BIN=""
SEARCH_DIRS=(
    "${HOME}/.steam/root/compatibilitytools.d"
    "${HOME}/.local/share/Steam/compatibilitytools.d"
    "${HOME}/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d"
    "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d"
)
for lib in "${STEAM_LIBS[@]}"; do
    SEARCH_DIRS+=("${lib}/compatibilitytools.d" "${lib}/steamapps/common")
done

for dir in "${SEARCH_DIRS[@]}"; do
    if [ -d "$dir" ]; then
        cand=$(find "$dir" -maxdepth 3 -name "proton" -type f -perm -111 2>/dev/null | grep -E "Proton-CachyOS|GE-Proton|Proton - Experimental|Proton [0-9]" | head -n 1 || true)
        [ -n "$cand" ] && [ -x "$cand" ] && { PROTON_BIN="$cand"; break; }
    fi
done

if [ -z "$PROTON_BIN" ]; then
    for dir in "${SEARCH_DIRS[@]}"; do
        if [ -d "$dir" ]; then
            cand=$(find "$dir" -maxdepth 3 -name "proton" -type f -perm -111 2>/dev/null | head -n 1 || true)
            [ -n "$cand" ] && [ -x "$cand" ] && { PROTON_BIN="$cand"; break; }
        fi
    done
fi

# 5. Check if Flatpak Steam is used
IS_FLATPAK=false
STEAM_CLIENT_PATH="${HOME}/.local/share/Steam"
if [ -d "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam" ] || (command -v flatpak >/dev/null && flatpak info com.valvesoftware.Steam >/dev/null 2>&1); then
    IS_FLATPAK=true
    STEAM_CLIENT_PATH="${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam"
fi

# 6. Locate OK-WW application directory inside prefix
APP_DIR=""
if [ -d "${PFX_PATH}/drive_c/users" ]; then
    for u_dir in "${PFX_PATH}/drive_c/users"/*; do
        cand="${u_dir}/AppData/Local/ok-ww"
        [ -d "$cand" ] && { APP_DIR="$cand"; break; }
    done
fi

PFX_USER="steamuser"
if [ -n "$APP_DIR" ]; then
    PFX_USER="$(basename "$(dirname "$(dirname "$(dirname "$APP_DIR")")")")"
fi
[ -z "$APP_DIR" ] && APP_DIR="${PFX_PATH}/drive_c/users/steamuser/AppData/Local/ok-ww"
WORKING_DIR="${APP_DIR}/data/apps/ok-ww/working"
PYTHON_EXE="C:\\users\\${PFX_USER}\\AppData\\Local\\ok-ww\\data\\apps\\ok-ww\\python\\python.exe"
MAIN_PY="C:\\users\\${PFX_USER}\\AppData\\Local\\ok-ww\\data\\apps\\ok-ww\\working\\main.py"
LAUNCHER_EXE="C:\\users\\${PFX_USER}\\AppData\\Local\\ok-ww\\ok-ww.exe"

# If working directory exists, ensure patches are active
if [ -d "${WORKING_DIR}" ] && [ -f "${SCRIPT_DIR}/patch_wine_compat.py" ]; then
    python3 "${SCRIPT_DIR}/patch_wine_compat.py" "${PFX_PATH}" >/dev/null 2>&1 || true
fi

TARGET_EXE="${LAUNCHER_EXE}"
TARGET_ARG=""

if [ "$1" = "--direct" ] || [ "$1" = "--python" ] || [ ! -f "${APP_DIR}/ok-ww.exe" ]; then
    TARGET_EXE="${PYTHON_EXE}"
    TARGET_ARG="${MAIN_PY}"
    [ "$1" = "--direct" ] || [ "$1" = "--python" ] && shift
fi

# Detect installed WebView2 Runtime path
WV2_DIR=""
for check_path in "${PFX_PATH}/drive_c/Program Files (x86)/Microsoft/EdgeWebView/Application" "${PFX_PATH}/drive_c/Program Files/Microsoft/EdgeWebView/Application"; do
    if [ -d "$check_path" ]; then
        for v_dir in "$check_path"/*; do
            if [ -d "$v_dir" ] && [ -f "${v_dir}/msedgewebview2.exe" ]; then
                v_name="$(basename "$v_dir")"
                WV2_DIR="C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\${v_name}"
                break 2
            fi
        done
    fi
done

# 7. WebView2 render-fix: the launcher (ok-ww.exe) needs a >=2px resize after
#    startup or Chromium never presents its first frame (blank white window).
#    Both processes must share one wineserver, so the render-fix helper runs in
#    the same process tree as the app (same container). Direct/python modes
#    have no webview and skip the fix.
RESOURCE_DIR=""
for cand in "${SCRIPT_DIR}" "${HOME}/.local/share/ok-wuwa"; do
    if [ -f "$cand/cursor_visible.py" ] && [ -f "$cand/webview2_render_fix.py" ]; then
        RESOURCE_DIR="$cand"
        break
    fi
done

RENDER_FIX_WIN=""
if [ "$TARGET_EXE" = "${LAUNCHER_EXE}" ]; then
    if [ -n "$RESOURCE_DIR" ] && [ -f "${RESOURCE_DIR}/webview2_render_fix.py" ]; then
        RENDER_FIX_WIN="Z:$(printf '%s' "${RESOURCE_DIR}/webview2_render_fix.py" | sed 's|/|\\|g')"
    else
        echo "Warning: WebView2 render-fix helper not installed; run setup.sh." >&2
    fi
fi

export OKWW_PROTON="${PROTON_BIN}"
export OKWW_TARGET="${TARGET_EXE}"
export OKWW_PYTHON="${PYTHON_EXE}"
export OKWW_FIX="${RENDER_FIX_WIN}"
export OKWW_ARGS="${TARGET_ARG:+${TARGET_ARG} }$*"
INNER='if [ -z "$OKWW_FIX" ]; then exec "$OKWW_PROTON" runinprefix "$OKWW_TARGET" $OKWW_ARGS; fi
"$OKWW_PROTON" runinprefix "$OKWW_TARGET" $OKWW_ARGS &
"$OKWW_PROTON" runinprefix "$OKWW_PYTHON" "$OKWW_FIX"
wait'

# 8. Execute OK-WuWa inside the Steam Linux Runtime container.
#    The cursor watcher (host-side) defines a theme cursor on the ok-ww
#    window so KWin shows the mouse cursor over it (KWin renders no cursor
#    over cursor-less XWayland windows).
if [ -n "$RESOURCE_DIR" ] && [ -f "${RESOURCE_DIR}/cursor_visible.py" ]; then
    ( python3 "${RESOURCE_DIR}/cursor_visible.py" >/dev/null 2>&1 & ) 2>/dev/null || true
fi

if [ "$IS_FLATPAK" = true ] && [ -n "${ENTRY_POINT}" ]; then
    exec flatpak run \
        --env=STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_PATH}" \
        --env=STEAM_COMPAT_DATA_PATH="${COMPAT_DATA_PATH}" \
        ${WV2_DIR:+--env=WEBVIEW2_BROWSER_EXECUTABLE_FOLDER="${WV2_DIR}"} \
        --command="${ENTRY_POINT}" \
        com.valvesoftware.Steam \
        --verb=runinprefix -- bash -c "$INNER"
elif [ -n "${ENTRY_POINT}" ]; then
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_PATH}"
    export STEAM_COMPAT_DATA_PATH="${COMPAT_DATA_PATH}"
    [ -n "$WV2_DIR" ] && export WEBVIEW2_BROWSER_EXECUTABLE_FOLDER="${WV2_DIR}"
    exec "${ENTRY_POINT}" --verb=runinprefix -- bash -c "$INNER"
else
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_CLIENT_PATH}"
    export STEAM_COMPAT_DATA_PATH="${COMPAT_DATA_PATH}"
    [ -n "$WV2_DIR" ] && export WEBVIEW2_BROWSER_EXECUTABLE_FOLDER="${WV2_DIR}"
    exec bash -c "$INNER"
fi
